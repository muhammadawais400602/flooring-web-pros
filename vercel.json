{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(frames|frames-m|frames-avif|frames-m-avif)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "flooring-web-pros.vercel.app"
        }
      ],
      "destination": "https://www.flooringwebpros.com/:path",
      "permanent": true
    }
  ]
}
